name "dentrite"
description "Retained UI on signals with immediate islands: core, SDL3 platform, GL 3.3 and software renderers"

configuration "default" {
    targetType "none"
    dependency "dentrite:sdl3" version="*"
}

// `dub test` from here runs the tests of every subpackage.
configuration "unittest" {
    targetType "library"
    targetPath "bin"
    sourcePaths "core/source" "gl33/source" "sdl3/source"
    importPaths "core/source" "gl33/source" "sdl3/source"
    libs "freetype" "harfbuzz" "SDL3"
    lflags "/LIBPATH:$PACKAGE_DIR/winlibs" platform="windows"
}

// `dub test -c unittest-static`, with SDL3 linked in like `dentrite:sdl3/static`.
configuration "unittest-static" {
    platforms "linux" "windows"
    targetType "library"
    targetPath "bin"
    sourcePaths "core/source" "gl33/source" "sdl3/source"
    importPaths "core/source" "gl33/source" "sdl3/source"
    libs "freetype" "harfbuzz"
    lflags "/LIBPATH:$PACKAGE_DIR/winlibs" platform="windows"
    lflags "$PACKAGE_DIR/winlibs/libSDL3.a" platform="linux"
    libs "m" "pthread" platform="linux"
    libs "SDL3-static" "kernel32" "user32" "gdi32" "winmm" "imm32" "ole32" "oleaut32" "version" "uuid" \
        "advapi32" "setupapi" "shell32" "dinput8" platform="windows"
}

subPackage {
    name "core"
    description "Core Dentrite library"
    targetType "library"
    targetPath "bin"
    sourcePaths "core/source"
    importPaths "core/source"
    libs "freetype" "harfbuzz"
    lflags "/LIBPATH:$PACKAGE_DIR/winlibs" platform="windows"
}

subPackage {
    name "gl33"
    description "OpenGL 3.3 renderer (dynamically loaded)"
    targetType "library"
    targetPath "bin"
    sourcePaths "gl33/source"
    importPaths "gl33/source"
    dependency "dentrite:core" version="*"
}

subPackage {
    name "sdl3"
    description "SDL3 platform, supports GL 3.3 and software"
    targetType "library"
    targetPath "bin"
    sourcePaths "sdl3/source"
    importPaths "sdl3/source"
    lflags "/LIBPATH:$PACKAGE_DIR/winlibs" platform="windows"
    dependency "dentrite:core" version="*"
    dependency "dentrite:gl33" version="*"

    configuration "dynamic" {
        libs "SDL3"
    }

    // SDL3 linked in from winlibs/, built by `rdmd tools/winlibs.d --sdl3`, which also checks the system
    // libraries below against SDL's own list. Pick it with `dub build --override-config=dentrite:sdl3/static`.
    configuration "static" {
        platforms "linux" "windows"
        lflags "$PACKAGE_DIR/winlibs/libSDL3.a" platform="linux"
        libs "m" "pthread" platform="linux"
        libs "SDL3-static" "kernel32" "user32" "gdi32" "winmm" "imm32" "ole32" "oleaut32" "version" "uuid" \
            "advapi32" "setupapi" "shell32" "dinput8" platform="windows"
    }
}
